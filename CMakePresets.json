{
    "version": 8,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/vs.${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "YES",
                "CLANG_TIDY": "OFF",
                "TARGET_NUCLEO": "OFF",
                "TARGET_REV1": "OFF"
            }
        },
        {
            "name": "unit-tests",
            "hidden": true,
            "inherits": "default",
            "cacheVariables": {
                "TESTS": "ON"
            }
        },
        {
            "name": "firmware-nucleo",
            "hidden": false,
            "toolchainFile": "cmake/target_stm32h7a3xx.cmake",
            "inherits": "default",
            "cacheVariables": {
                "TESTS": "OFF",
                "TARGET_NUCLEO": "ON"
            }
        },
        {
            "name": "firmware-rev1",
            "hidden": false,
            "toolchainFile": "cmake/target_stm32h562xx.cmake",
            "inherits": "default",
            "cacheVariables": {
                "TESTS": "OFF",
                "TARGET_REV1": "ON"
            }
        },
        {
            "name": "clang-tidy",
            "hidden": true,
            "cacheVariables": {
                "CLANG_TIDY": "ON"
            }
        },
        {
            "name": "windows",
            "hidden": true,
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "linux",
            "hidden": true,
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "unit-tests.coverage.gcc.linux",
            "toolchainFile": "cmake/toolchain_linux_gcc_coverage.cmake",
            "inherits": [
                "default",
                "linux"
            ],
            "cacheVariables": {
                "TESTS": "ON"
            }
        },
        {
            "name": "unit-tests.gcc.windows",
            "toolchainFile": "cmake/toolchain_windows_gcc.cmake",
            "inherits": [
                "unit-tests",
                "windows"
            ]
        },
        {
            "name": "unit-tests.gcc.windows.clang-tidy",
            "toolchainFile": "cmake/toolchain_windows_gcc.cmake",
            "inherits": [
                "clang-tidy",
                "unit-tests",
                "windows"
            ]
        },
        {
            "name": "unit-tests.gcc.linux",
            "toolchainFile": "cmake/toolchain_linux_gcc.cmake",
            "inherits": [
                "unit-tests",
                "linux"
            ]
        }
    ],
    "buildPresets": [
        {
            "name": "unit-tests.gcc.windows",
            "configurePreset": "unit-tests.gcc.windows"
        },
        {
            "name": "unit-tests.gcc.windows.clang-tidy",
            "configurePreset": "unit-tests.gcc.windows.clang-tidy"
        },
        {
            "name": "unit-tests.gcc.linux",
            "configurePreset": "unit-tests.gcc.linux"
        },
        {
            "name": "unit-tests.coverage.gcc.linux",
            "configurePreset": "unit-tests.coverage.gcc.linux"
        },
        {
            "name": "firmware-nucleo",
            "configurePreset": "firmware-nucleo"
        },
        {
            "name": "firmware-rev1",
            "configurePreset": "firmware-rev1"
        }
    ],
    "testPresets": [
        {
            "name": "unit-tests.gcc.windows",
            "configurePreset": "unit-tests.gcc.windows"
        },
        {
            "name": "unit-tests.gcc.linux",
            "configurePreset": "unit-tests.gcc.linux"
        },
        {
            "name": "unit-tests.coverage.gcc.linux",
            "configurePreset": "unit-tests.coverage.gcc.linux"
        }
    ]
}